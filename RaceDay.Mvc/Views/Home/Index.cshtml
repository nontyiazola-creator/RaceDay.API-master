@{
    ViewData["Title"] = "Welcome to RaceDay";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold" style="color:#1d3557;">
        Welcome to RaceDay
    </h1>
    <p class="lead text-muted mb-4">
        The platform for running, walking and cycling events
    </p>

    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Auth" asp-action="Login" class="btn btn-lg btn-raceday px-4">
            Login
        </a>
        <a asp-controller="Auth" asp-action="Register" class="btn btn-lg btn-outline-dark px-4">
            Register
        </a>
    </div>
</div>