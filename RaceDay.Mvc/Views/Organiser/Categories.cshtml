@model List<RaceDay.Mvc.ViewModels.Organiser.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    var eventDetails = ViewBag.Event as RaceDay.Mvc.ViewModels.Organiser.EventViewModel;
}

<div class="container py-4">
    <h1 class="fw-bold">Manage Categories</h1>

    @if (eventDetails != null)
    {
        <p class="text-muted">
            Event: <strong>@eventDetails.EventName</strong>
        </p>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="fw-bold mb-3">Add a Category</h5>

            <form asp-action="AddCategory" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="EventID"
                       value="@eventDetails?.EventID" />

                <div class="mb-3">
                    <label class="form-label">Category Name</label>
                    <input name="CategoryName" class="form-control"
                           placeholder="e.g. 10km Open" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="Description" class="form-control"
                              rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary">
                    Add Category
                </button>
            </form>
        </div>
    </div>

    <h4 class="fw-bold mb-3">Existing Categories</h4>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <input form="edit-@category.CategoryID"
                                       name="CategoryName"
                                       value="@category.CategoryName"
                                       class="form-control" required />
                            </td>

                            <td>
                                <input form="edit-@category.CategoryID"
                                       name="Description"
                                       value="@category.Description"
                                       class="form-control" />
                            </td>

                            <td>
                                <form id="edit-@category.CategoryID"
                                      asp-action="EditCategory"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="CategoryID"
                                           value="@category.CategoryID" />
                                    <input type="hidden" name="EventID"
                                           value="@category.EventID" />
                                </form>

                                <button type="submit"
                                        form="edit-@category.CategoryID"
                                        class="btn btn-sm btn-primary">
                                    Save
                                </button>

                                <form asp-action="DeleteCategory"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Delete this category?');">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id"
                                           value="@category.CategoryID" />
                                    <input type="hidden" name="eventId"
                                           value="@category.EventID" />

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
