@model List<RaceDay.Mvc.ViewModels.Organiser.EnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
    int eventId = ViewBag.EventID ?? 0;
}

<div class="container py-4">
    <h1 class="fw-bold">Event Enrolments</h1>
    <p class="text-muted">Participants registered for this event.</p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            There are currently no enrolments for this event.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enrolment in Model)
                    {
                        <tr>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge bg-success">
                                    @enrolment.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-action="Index" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

    <a asp-action="Results" asp-route-id="@eventId"
       class="btn btn-primary mt-3">
        Manage Results
    </a>
</div>