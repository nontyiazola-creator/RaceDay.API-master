@model List<RaceDay.Mvc.ViewModels.Organiser.EventViewModel>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Organiser Dashboard</h1>
            <p class="text-muted">Manage your RaceDay events.</p>
        </div>

        <a asp-action="CreateEvent" class="btn btn-primary">
            Create New Event
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You haven't created any events yet.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">
                                @item.EventName
                            </h5>

                            <p class="text-muted">
                                @item.Description
                            </p>

                            <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.Distance km</p>
                            <p><strong>Type:</strong> @item.EventType</p>

                            <div class="d-grid gap-2">
                                <a asp-action="EditEvent"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-primary">
                                    Edit Event
                                </a>

                                <a asp-action="Categories"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-secondary">
                                    Manage Categories
                                </a>

                                <a asp-action="Enrolments"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-success">
                                    View Enrolments
                                </a>

                                <a asp-action="Results"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-outline-dark">
                                    Manage Results
                                </a>

                                <form asp-action="DeleteEvent"
                                      asp-route-id="@item.EventID"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this event?');">

                                    <button type="submit" class="btn btn-danger w-100">
                                        Delete Event
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>