@model RaceDay.Mvc.ViewModels.Participant.ParticipantEventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="container py-4">
    <a asp-action="Index" class="btn btn-outline-secondary mb-3">Back to Events</a>

    <h1 class="fw-bold">@Model.Event.EventName</h1>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <p class="text-muted">@Model.Event.Description</p>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p><strong>Date:</strong> @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
            <p><strong>Location:</strong> @Model.Event.Location</p>
            <p><strong>Distance:</strong> @Model.Event.Distance km</p>
            <p><strong>Event Type:</strong> @Model.Event.EventType</p>
        </div>
    </div>

    <h3 class="fw-bold mb-3">Available Categories</h3>

    @if (!Model.Categories.Any())
    {
        <div class="alert alert-info">No categories have been added to this event yet.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var category in Model.Categories)
            {
                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <h5>@category.CategoryName</h5>
                            <p class="text-muted">@category.Description</p>

                            <form asp-action="Enrol" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                                <input type="hidden" name="categoryId" value="@category.CategoryID" />
                                <button type="submit" class="btn btn-success">
                                    Enrol Now
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
