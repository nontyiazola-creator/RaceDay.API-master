@model List<RaceDay.Mvc.ViewModels.Participant.ParticipantEventViewModel>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container py-4">
    <h1 class="fw-bold mb-2">Upcoming Events</h1>
    <p class="text-muted mb-4">Discover your next RaceDay challenge.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">There are currently no upcoming events.</div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.EventName</h5>
                            <p class="text-muted">@item.Description</p>
                            <p><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                            <p><strong>Location:</strong> @item.Location</p>
                            <p><strong>Distance:</strong> @item.Distance km</p>
                            <p><strong>Type:</strong> @item.EventType</p>

                            <a asp-action="EventDetails"
                               asp-route-id="@item.EventID"
                               class="btn btn-primary">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
