@model List<RaceDay.Mvc.ViewModels.Participant.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container py-4">
    <h1 class="fw-bold mb-2">My Results</h1>
    <p class="text-muted mb-4">View your recorded RaceDay performances.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            You don't have any recorded results yet. Check back after your events!
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Recorded</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>@result.EventName</td>
                            <td>@result.CategoryName</td>
                            <td>
                                @(result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "Not recorded")
                            </td>
                            <td>@(result.FinishPosition?.ToString() ?? "Not recorded")</td>
                            <td>@result.RecordedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
